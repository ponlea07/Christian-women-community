---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FounderWelcome from "../components/FounderWelcome.astro";
import BecomeVirtuosa from "../components/BecomeVirtuosa.astro";
---

<Layout title="About | Christian Women Community">

  <!-- HERO -->

  <section class="page-hero">

    <div class="container">

      <span class="page-eyebrow">
        ABOUT US
      </span>

      <h1>

        Welcome Home

      </h1>

      <p>

        Christian Women Community exists to help women grow in Christ,
        discover purpose, build meaningful relationships and become
        everything God has created them to be.

      </p>

    </div>

  </section>

  <!-- OUR STORY -->

  <section class="about-story">

    <div class="container">

      <SectionHeading

        eyebrow="OUR STORY"

        title="Born From A Burden"

        text="Every ministry begins with a burden from God."

      />

      <div class="story-content">

        <p>

          Christian Women Community was born from a simple but powerful conviction:
          no woman should have to walk her journey of faith alone.

        </p>

        <p>

          We believe every woman is uniquely created by God, richly gifted,
          deeply loved and called to influence her generation for Christ.

        </p>

        <p>

          Donna Virtuosa—More Than Rubies—is our reminder that every woman
          carries immeasurable value in God's Kingdom.

        </p>

      </div>

    </div>

  </section>

  <!-- VISION + MISSION -->

  <section class="vision-mission">

    <div class="container vm-grid">

      <div class="vm-card">

        <h2>Our Vision</h2>

        <p>

          To raise Christ-centred women who influence their generation with
          wisdom, excellence, compassion and unwavering faith.

        </p>

      </div>

      <div class="vm-card featured">

        <h2>Our Mission</h2>

        <p>

          Creating a global Christ-centred community where women grow
          spiritually, discover purpose, build authentic relationships and
          advance God's Kingdom together.

        </p>

      </div>

    </div>

  </section>

  <!-- THE VIRTUOSA WAY -->

  <section class="values">

    <div class="container">

      <SectionHeading

        eyebrow="THE VIRTUOSA WAY"

        title="Five Values That Shape Our Community"

        text="These principles influence every gathering, conversation and initiative within Christian Women Community."

      />

      <div class="values-grid">

        <div class="value-card">

          <h3>Christ First</h3>

          <p>

            We seek His presence before pursuing His promises.

          </p>

        </div>

        <div class="value-card">

          <h3>Sisterhood Always</h3>

          <p>

            Every woman deserves genuine friendship and support.

          </p>

        </div>

        <div class="value-card">

          <h3>Purpose Every Day</h3>

          <p>

            We help women discover and fulfil God's calling.

          </p>

        </div>

        <div class="value-card">

          <h3>Excellence</h3>

          <p>

            We honour God by giving Him our very best.

          </p>

        </div>

        <div class="value-card">

          <h3>Kingdom Impact</h3>

          <p>

            We influence homes, communities and nations for Christ.

          </p>

        </div>

      </div>

    </div>

  </section>

  <FounderWelcome />

  <BecomeVirtuosa />

</Layout>