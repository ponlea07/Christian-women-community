---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ContinueReading from "../../components/bible/ContinueReading.astro";
import { getDailyVerse } from "../../lib/bible/dailyVerse";
import ScriptureCard from "../../components/design/ScriptureCard.astro";
import PrimaryButton from "../../components/design/PrimaryButton.astro";
const verse = getDailyVerse();

const testaments = [
  {
    title: "Old Testament",
    description: "39 books from Genesis to Malachi",
    href: "/bible/old-testament"
  },
  {
    title: "New Testament",
    description: "27 books from Matthew to Revelation",
    href: "/bible/new-testament"
  }
];
---

<Layout title="Bible Hub | Christian Women Community">
<section class="page-hero">

  <div class="container">

    <span class="page-eyebrow">
      GOD'S WORD
    </span>

    <h1>Bible Hub</h1>

<p>
  Read, search and study God's Word in one beautiful experience.
</p>

  </div>

</section>
<ContinueReading />

<section class="quick-access">

  <div class="container">

    <SectionHeading
  eyebrow="TOOLS"
  title="Study & Explore"
  text="Everything you need to read, search and study God's Word."
  theme="light"
/>

<div class="resources-grid">

  <article class="resource-card">

  <h3>🔍 Search Scripture</h3>

  <p>
    Quickly find verses, passages and keywords across the Bible.
  </p>

  <a href="/bible/search" class="btn-primary">
    Open →
  </a>

</article>

<article class="resource-card">

  <h3>⭐ Bookmarks</h3>

  <p>
    Save your favourite chapters and verses for easy access anytime.
  </p>

  <a href="/bible/bookmarks" class="btn-primary">
    Open →
  </a>

</article>

<article class="resource-card">

  <h3>📝 Notes</h3>

  <p>
    Capture personal reflections and insights as you study Scripture.
  </p>

  <a href="/bible/notes" class="btn-primary">
    Open →
  </a>

</article>

</div>

  </div>

</section>

<section class="daily-verse-preview">

  <div class="container">

    <SectionHeading
      eyebrow="TODAY'S VERSE"
      title="God's Word For Today"
      theme="light"
    />

    <ScriptureCard
      reference={verse.reference}
      text={verse.text}
    />

    <PrimaryButton href={`/bible/${verse.book}/${verse.chapter}`}>
      Read Full Chapter →
    </PrimaryButton>

  </div>

</section>
<section class="resources-page">

<div class="container">

<SectionHeading
eyebrow="THE HOLY SCRIPTURES"
title="Start Reading the Bible Today"
text="Choose where you'd like to begin your journey through Scripture."
/>

<div class="resources-grid">

{testaments.map((item)=>(

<article class="resource-card">

<h3>{item.title}</h3>

<p>{item.description}</p>

<a href={item.href} class="btn-primary">

Open →

</a>

</article>

))}

</div>

</div>

</section>

<section class="quick-access">

  <div class="container">

    <SectionHeading
      eyebrow="COMING NEXT"
      title="More Bible Study Tools"
      text="We're continually adding new features to make your Bible study experience richer and more meaningful."
      theme="light"
    />

    <div class="resources-grid">

      <!-- Reading Plans -->
      <article class="resource-card">

        <h3>📅 Reading Plans</h3>

        <p>
          Follow guided Bible reading plans designed to help you stay
          consistent in God's Word.
        </p>

        <span class="coming-soon-badge">
          Coming Soon
        </span>

      </article>

      <!-- Verse Highlights -->
      <article class="resource-card">

        <h3>❤️ Verse Highlights</h3>

        <p>
          Highlight meaningful verses using different colours and revisit
          them whenever you need encouragement.
        </p>

        <span class="coming-soon-badge">
          Coming Soon
        </span>

      </article>

    </div>

  </div>

</section>

</Layout>

<style>
.daily-verse-preview{
  text-align:center;
  padding:3rem 1.5rem;
}

.daily-verse-preview .scripture-card{
  margin-bottom:3rem;
}
.quick-access{
  padding:3rem 0;
}

.quick-access .resources-grid{
  margin-top:2rem;
}

.quick-access .section-heading p{
    color:var(--color-text);
}
.coming-soon-badge{
    display:inline-block;
    margin-top:1.5rem;
    padding:.45rem 1rem;
    background:#0F6B73;
    color:#D4AF37;
    border-radius:999px;
    font-size:.8rem;
    font-weight:700;
    letter-spacing:1px;
    text-transform:uppercase;
}
</style>
<script>
  import "../../scripts/continue-reading";
</script>

