---
import Layout from "../../layouts/Layout.astro";
import BibleHubBackLink from "../../components/bible/BibleHubBackLink.astro";
---

<Layout title="My Bookmarks">
  <main class="bookmarks-page">
    <section class="bookmarks-hero">
      <div class="bookmarks-heading">
        <h1>📚 My Bookmarks</h1>

        <p>
          Quickly return to the passages you've saved.
        </p>

        <div class="bookmarks-flourish" aria-hidden="true">
          <span></span>
          <strong>✦</strong>
          <span></span>
        </div>
      </div>
    </section>

    <section class="bookmarks-content">
      <div id="bookmarks-list" class="bookmarks-list"></div>

      <BibleHubBackLink />
    </section>
  </main>
</Layout>

<script src="../../scripts/bookmarks-page.ts"></script>

<style>
  .bookmarks-page {
    min-height: 100vh;
    padding: 4rem 1.5rem 6rem;
  }

  /* -----------------------------------------
     Page heading
     ----------------------------------------- */

  .bookmarks-hero {
    width: min(900px, 100%);
    margin: 0 auto 3rem;
  }

  .bookmarks-heading {
    text-align: center;
  }

  .bookmarks-heading h1 {
    margin: 0;

    color: #ffffff;

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size: clamp(2.2rem, 5vw, 3.2rem);

    line-height: 1.1;
  }

  .bookmarks-heading p {
    max-width: 620px;

    margin: 1rem auto 0;

    color: rgba(255, 255, 255, 0.85);

    font-family: "Poppins", sans-serif;

    font-size: 1rem;

    line-height: 1.7;
  }

  .bookmarks-flourish {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 1rem;

    width: min(270px, 80%);

    margin: 1.5rem auto 0;
  }

  .bookmarks-flourish span {
    flex: 1;

    height: 1px;

    background: linear-gradient(
      to right,
      transparent,
      #d4af37
    );
  }

  .bookmarks-flourish span:last-child {
    background: linear-gradient(
      to left,
      transparent,
      #d4af37
    );
  }

  .bookmarks-flourish strong {
    color: #d4af37;

    font-size: 1.2rem;

    font-weight: 400;
  }

  /* -----------------------------------------
     Bookmark content
     ----------------------------------------- */

  .bookmarks-content {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .bookmarks-list {
    display: grid;
    gap: 1.5rem;
  }

  /* -----------------------------------------
     Dynamically rendered bookmark cards
     ----------------------------------------- */

  .bookmarks-list :global(.bookmark-card) {
    position: relative;

    padding: 2rem;

    border-radius: 1rem;

    background: rgba(255, 255, 255, 0.06);

    border: 1px solid rgba(212, 175, 55, 0.22);

    border-left: 4px solid #d4af37;

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .bookmarks-list :global(.bookmark-reference) {
    margin: 0 0 0.75rem;

    color: #d4af37;

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size: 1.6rem;

    font-weight: 700;
  }

  .bookmarks-list :global(.bookmark-card p) {
    margin: 0 0 0.5rem;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: 1rem;
  }

  .bookmarks-list :global(.bookmark-date) {
    display: block;

    margin-top: 0.35rem;

    color: rgba(255, 255, 255, 0.65);

    font-family: "Poppins", sans-serif;

    font-size: 0.85rem;
  }

  .bookmarks-list :global(.bookmark-actions) {
    display: flex;

    align-items: center;

    gap: 1rem;

    margin-top: 1.5rem;

    flex-wrap: wrap;
  }

  /* Open button */

  .bookmarks-list :global(.bookmark-open) {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0.75rem 1.5rem;

    background: #d4af37;

    color: #ffffff;

    border-radius: 999px;

    font-family: "Poppins", sans-serif;

    font-size: 0.9rem;

    font-weight: 600;

    text-decoration: none;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .bookmarks-list :global(.bookmark-open:hover) {
    transform: translateY(-2px);

    box-shadow:
      0 10px 24px rgba(212, 175, 55, 0.3);
  }

  /* Delete button */

  .bookmarks-list :global(.bookmark-delete) {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0.75rem 1.25rem;

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 999px;

    background: transparent;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: 0.9rem;

    font-weight: 500;

    cursor: pointer;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .bookmarks-list :global(.bookmark-delete:hover) {
    background: rgba(212, 175, 55, 0.12);

    border-color: #d4af37;

    color: #d4af37;
  }

  /* -----------------------------------------
     Empty state
     ----------------------------------------- */

  .bookmarks-list :global(.bookmark-empty) {
  padding: 4rem 2rem;

  text-align: center;

  border-radius: 1rem;

  background: rgba(255, 255, 255, 0.05);

  border: 1px solid rgba(212, 175, 55, 0.2);
}

.bookmarks-list :global(.bookmark-empty-icon) {
  margin-bottom: 1rem;

  color: #d4af37;

  font-size: 1.6rem;

  line-height: 1;
}

.bookmarks-list :global(.bookmark-empty h2) {
  margin: 0 0 0.75rem;

  color: #ffffff;

  font-family:
    "Cormorant Garamond",
    Georgia,
    serif;

  font-size: 2rem;
}

.bookmarks-list :global(.bookmark-empty p) {
  max-width: 560px;

  margin: 0 auto;

  color: rgba(255, 255, 255, 0.78);

  line-height: 1.7;
}

  /* -----------------------------------------
     Mobile
     ----------------------------------------- */

  @media (max-width: 640px) {
    .bookmarks-page {
      padding: 3rem 1rem 4rem;
    }

    .bookmarks-list :global(.bookmark-card) {
      padding: 1.5rem;
    }

    .bookmarks-list :global(.bookmark-actions) {
      align-items: stretch;

      flex-direction: column;
    }

    .bookmarks-list :global(.bookmark-open),
    .bookmarks-list :global(.bookmark-delete) {
      width: 100%;
    }
  }
</style>
