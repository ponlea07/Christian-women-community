---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="My Bookmarks">

  <section class="bookmarks-page">

    <h1>📚 My Bookmarks</h1>

    <p>
      Quickly return to the passages you've saved.
    </p>

    <div id="bookmarks-list"></div>

  </section>

</Layout>

<style>
.bookmarks-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
  min-height: 60vh;
}

.bookmarks-page h1 {
  text-align: center;
  margin-bottom: .5rem;
}

.bookmarks-page > p {
  text-align: center;
  opacity: .8;
  margin-bottom: 3rem;
}

#bookmarks-list {
  display: grid;
  gap: 1.5rem;
}

.bookmark-card {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 1.5rem;

  border: 1px solid rgba(255,255,255,.15);
  border-radius: 16px;

  background: rgba(255,255,255,.05);

  transition:
    transform .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.bookmark-card:hover {
  transform: translateY(-2px);
  border-color: rgba(212,175,55,.6);
  background: rgba(255,255,255,.08);
}

.bookmark-content h3 {
  margin: 0 0 .35rem;
}

.bookmark-content p {
  margin: 0;
  opacity: .85;
}

.bookmark-date {
  display: block;
  margin-top: .6rem;
  opacity: .7;
  font-size: .9rem;
}

.bookmark-actions {
  display: flex;
  gap: .75rem;
}

.bookmark-open,
.bookmark-delete {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 96px;

  padding: .75rem 1rem;

  border-radius: 10px;

  font-weight: 600;

  text-decoration: none;

  cursor: pointer;

  transition: all .2s ease;
}

.bookmark-open {
  background: #D4AF37;
  color: #0F6B73;
}

.bookmark-open:hover {
  transform: translateY(-1px);
}

.bookmark-delete {
  border: 1px solid #c0392b;
  background: transparent;
  color: #fff;
}

.bookmark-delete:hover {
  background: #c0392b;
}

.empty-bookmarks {
  text-align: center;
  padding: 5rem 1rem;
}

.empty-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.empty-bookmarks h2 {
  margin-bottom: .75rem;
}

.empty-bookmarks p {
  max-width: 420px;
  margin: 0 auto;
  opacity: .85;
}

@media (max-width: 768px) {

  .bookmark-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .bookmark-actions {
    width: 100%;
    margin-top: 1rem;
  }

  .bookmark-open,
  .bookmark-delete {
    flex: 1;
  }

}
</style>

<script>
  import "../../scripts/bookmarks-page";
</script>