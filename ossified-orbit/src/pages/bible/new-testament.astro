---
import { books } from "../../content/bible/books";
import Layout from "../../layouts/Layout.astro";

const newTestament = books.filter(
  book => book.testament === "new"
);
---

<Layout title="New Testament">

<section class="resources-page">

<div class="container">

<h1>New Testament</h1>

<div class="resources-grid">

{newTestament.map((book) => (

<article class="resource-card">

<h3>{book.name}</h3>

<p>{book.chapters} Chapters</p>

<a href={`/bible/${book.slug}`} class="btn-primary">

Read →

</a>

</article>

))}

</div>

</div>

</section>

</Layout>