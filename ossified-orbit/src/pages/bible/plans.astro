---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { readingPlans } from "../../content/bible/reading-plans/plans";
---

<Layout title="Reading Plans">
  <main class="reading-plans-page">

    <section class="plans-hero">
      <SectionHeading
        eyebrow="BIBLE HUB"
        title="Reading Plans"
        text="Follow a guided journey through God's Word and build a consistent rhythm of Scripture reading."
        theme="light"
      />
    </section>


<section class="plans-section">
  <div class="plans-grid">
    {
      readingPlans.map((plan) => {
        const totalChapters = plan.days.reduce(
          (total, day) => total + day.readings.length,
          0
        );

        return (
          <article class="plan-card">
            <div class="plan-icon" aria-hidden="true">
              {plan.icon}
            </div>

            <span class="plan-category">
              {plan.category}
            </span>

            <h2>{plan.title}</h2>

            <p>{plan.description}</p>

            <div class="plan-meta">
              <span>
                📅 {plan.durationLabel}
              </span>

              <span>
                📖 {totalChapters.toLocaleString()} chapters
              </span>
            </div>

            <a
              class="plan-button"
              href={`/bible/plans/${plan.id}`}
            >
              View Plan →
            </a>
          </article>
        );
      })
    }
  </div>
</section>

  </main>
</Layout>

<style>
  .reading-plans-page {
    min-height: 100vh;
    padding: 4rem 1.5rem 6rem;
  }

  .plans-hero {
    width: min(900px, 100%);
    margin: 0 auto 1rem;
    text-align: center;
  }

 .plans-section {
  width: min(1100px, 100%);
  margin: -1rem auto 0;
}

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .plan-card {
    display: flex;
    flex-direction: column;

    min-height: 520px;
    padding: 2.25rem;

    border: 1px solid rgba(212, 175, 55, 0.22);
    border-left: 4px solid #d4af37;
    border-radius: 1rem;

    background: rgba(255, 255, 255, 0.06);

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .plan-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 58px;
    height: 58px;
    margin-bottom: 1.4rem;

    border-radius: 50%;

    background: rgba(212, 175, 55, 0.12);

    font-size: 1.7rem;
  }

  .plan-category {
    margin-bottom: 0.6rem;

    color: #d4af37;

    font-family: "Poppins", sans-serif;

    font-size: 0.75rem;
    font-weight: 700;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .plan-card h2 {
    margin: 0 0 1rem;

    color: #ffffff;

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size: 1.9rem;
    line-height: 1.15;
  }

  .plan-card p {
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-family: "Poppins", sans-serif;

    line-height: 1.7;
  }

  .plan-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    margin-top: auto;
    padding-top: 1.5rem;
    padding-bottom: 1.25rem;

    border-bottom: 1px solid rgba(212, 175, 55, 0.7);

    color: rgba(255, 255, 255, 0.78);

    font-family: "Poppins", sans-serif;

    font-size: 0.82rem;
  }

  .plan-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: fit-content;

    margin-top: 1.5rem;
    padding: 0.8rem 1.5rem;

    border-radius: 999px;

    background: #d4af37;
    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: 0.9rem;
    font-weight: 600;

    text-decoration: none;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .plan-button:hover {
    transform: translateY(-2px);

    box-shadow:
      0 10px 24px rgba(212, 175, 55, 0.3);
  }

  @media (max-width: 900px) {
    .plans-grid {
      grid-template-columns: 1fr;
    }

    .plan-card {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .reading-plans-page {
      padding: 3rem 1rem 4rem;
    }

    .plan-card {
      padding: 1.5rem;
    }

    .plan-button {
      width: 100%;
    }
  }
</style>