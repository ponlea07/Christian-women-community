---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Search Scripture">

  <section class="search-page">

    <p class="eyebrow">Bible Hub</p>

    <h1>Search Scripture</h1>

    <p class="subtitle">
      Search the Bible by word, phrase, book, or reference.
    </p>

    <form id="search-form" class="search-form">

      <input
        id="search-input"
        type="search"
        placeholder="Example: love, Genesis, John 3:16"
        autocomplete="off"
      />

      <button type="submit">
        Search
      </button>

    </form>

    <p id="results-count" class="results-count"></p>

    <div id="results" class="results"></div>

<div id="pagination" class="pagination"></div>
  </section>

</Layout>

<style>

.search-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
}

.subtitle {
  text-align: center;
  color: var(--color-muted-text);
  margin-bottom: 2rem;
}

.eyebrow {
  color: var(--color-accent);
  text-transform: uppercase;
  letter-spacing: .15em;
  text-align: center;
}

.search-page h1 {
  text-align: center;
  margin: 0.5rem 0;
}

.search-form {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}

.search-form input {
  flex: 1;
  padding: 1rem;
  border-radius: 12px;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-surface-text);
  font-size: 1rem;
}

.search-form input::placeholder{
  color:var(--color-surface-text-muted);
  opacity:1;
}

.search-form input:focus {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.search-form button {
  background: var(--color-accent);
  color: var(--color-button-text);
  border: none;
  padding: 1rem 1.5rem;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
}

.search-form button:hover {
  opacity: 0.9;
}

.results-count {
  margin-bottom: 1.5rem;
  color: var(--color-accent);
  font-weight: 600;
}

.results {
  display: grid;
  gap: 1rem;
}

:global(.result-card) {
  background: var(--color-surface);
  color: var(--color-surface-text);
  padding: 1.5rem;
  border: 1px solid var(--color-border);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

:global(.result-card h3) {
  margin: 0 0 0.75rem;
  color: var(--color-surface-text);
}

:global(.result-card p) {
  margin: 0;
  line-height: 1.7;
  color: var(--color-surface-text);
}

:global(.result-card a) {
  display: inline-block;
  margin-top: 1rem;
  color: var(--color-accent);
  text-decoration: none;
  font-weight: 600;
}

:global(.result-card a:hover) {
  text-decoration: underline;
}

:global(.pagination) {
  display: flex;
  justify-content: center;
  margin-top: 2rem;
}

:global(.pagination-nav) {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}

:global(.pagination-nav button) {
  min-width: 42px;
  height: 42px;
  padding: 0 0.9rem;

  border: 1px solid var(--color-border);
  border-radius: 10px;

  background: var(--color-surface);
  color: var(--color-brand);

  font-weight: 600;
  cursor: pointer;

  transition: all 0.2s ease;
}

:global(.pagination-nav button:hover:not(:disabled)) {
  background: var(--color-accent);
  color: var(--color-button-text);
}

:global(.pagination-nav button.active) {
  background: var(--color-accent);
  color: var(--color-button-text);
  border: 2px solid var(--color-accent);
  font-weight: 700;
}

:global(.pagination-nav button:disabled) {
  opacity: 0.5;
  cursor: not-allowed;
}

:global(.pagination-nav span) {
  padding: 0 0.5rem;
  color: var(--color-text);
  font-weight: bold;
}

@media (max-width: 768px) {
  .pagination-nav {
    gap: 0.35rem;
  }

  .pagination-nav button {
    min-width: 36px;
    height: 36px;
    font-size: 0.9rem;
    padding: 0 0.75rem;
  }
}

@media (max-width:768px){

  .search-form{
    flex-direction:column;
  }

}

</style>

<script>
  import "../../scripts/bible-search";
</script>
