---
import Layout from "../layouts/Layout.astro";
import GrowInTheWord from "../components/GrowInTheWord.astro";
import JoinModal from "../components/JoinModal.astro";
---

<Layout title="Become a Virtuosa | Christian Women Community">

<section class="page-hero">

<div class="container">

<span class="page-eyebrow">

BECOME A VIRTUOSA

</span>

<h1>

Your Journey Starts Here

</h1>

<p>

Join a Christ-centred community where women grow in faith,
discover purpose, build lasting friendships and impact the
world for Christ.

</p>

</div>

</section>

<section class="join-page">

<div class="container">

<div class="join-grid">

<div>

<h2>

Why Join?

</h2>

<ul class="benefits">

<li>Weekly Bible Study</li>

<li>Weekly Prayer Meetings</li>

<li>Christian Women's Hangout</li>

<li>Business & Leadership Growth</li>

<li>Mentorship Opportunities</li>

<li>Global Sisterhood</li>

<li>Exclusive Resources</li>

<li>Marketplace Opportunities</li>

</ul>

</div>

<div class="join-card">

  <span class="join-badge">
    Join Our Sisterhood
  </span>

  <h3>
    Become Part of the Community
  </h3>

  <p>
    Join a Christ-centred community where women grow in faith,
    discover purpose, build lasting friendships and make Kingdom impact.
  </p>

  <div class="join-highlights">

    <div>🙏 Weekly Prayer</div>

    <div>📖 Bible Study</div>

    <div>🤝 Mentorship</div>

    <div>🌍 Global Sisterhood</div>

  </div>

  <button
    id="openJoinModal"
    class="btn-primary">

    Become a Virtuosa

  </button>

</div>

</div>

</div>

</section>

<JoinModal />

<GrowInTheWord />

</Layout>