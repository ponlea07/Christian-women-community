---
import Layout from "../layouts/Layout.astro";
import GrowInTheWord from "../components/GrowInTheWord.astro";
---

<Layout title="Become a Virtuosa | Christian Women Community">

<section class="page-hero">

<div class="container">

<span class="page-eyebrow">

BECOME A VIRTUOSA

</span>

<h1>

Your Journey Starts Here

</h1>

<p>

Join a Christ-centred community where women grow in faith,
discover purpose, build lasting friendships and impact the
world for Christ.

</p>

</div>

</section>

<section class="join-page">

<div class="container">

<div class="join-grid">

<div>

<h2>

Why Join?

</h2>

<ul class="benefits">

<li>Weekly Bible Study</li>

<li>Weekly Prayer Meetings</li>

<li>Christian Women's Hangout</li>

<li>Business & Leadership Growth</li>

<li>Mentorship Opportunities</li>

<li>Global Sisterhood</li>

<li>Exclusive Resources</li>

<li>Marketplace Opportunities</li>

</ul>

</div>

<div class="join-form">

<h3>

Become Part of the Community

</h3>

<form
  action="https://formspree.io/f/xdarjdzy"
  method="POST">

  <input
  type="hidden"
  name="_next"
  value="https://christian-women-community.vercel.app/thank-you" />

  <input
    type="hidden"
    name="_subject"
    value="New Virtuosa Registration" />

  <input
    type="text"
    name="name"
    placeholder="Full Name"
    required />

  <input
    type="email"
    name="email"
    placeholder="Email Address"
    required />

  <input
    type="text"
    name="country"
    placeholder="Country" />

  <input
    type="text"
    name="church"
    placeholder="Church (Optional)" />

  <select name="heard_about_us">
    <option value="">How did you hear about us?</option>
    <option>Instagram</option>
    <option>Facebook</option>
    <option>YouTube</option>
    <option>Friend</option>
    <option>Church</option>
    <option>Google Search</option>
    <option>Other</option>
  </select>

  <textarea
    name="message"
    rows="5"
    placeholder="Tell us a little about yourself or share a prayer request"></textarea>

  <button
    type="submit"
    class="btn-primary">

    Become a Virtuosa

  </button>

</form>

</div>

</div>

</div>

</section>

<GrowInTheWord />

</Layout>