---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BecomeVirtuosa from "../components/BecomeVirtuosa.astro";
import GrowInTheWord from "../components/GrowInTheWord.astro";
---

<Layout title="Contact | Christian Women Community">

  <section class="page-hero">

    <div class="container">

      <span class="page-eyebrow">
        LET'S CONNECT
      </span>

      <h1>
        We'd Love to Hear From You
      </h1>

      <p>

        Whether you have a question, prayer request or would like to
        become part of our community, we'd love to connect with you.

      </p>

    </div>

  </section>

  <section class="contact-page">

    <div class="container">

      <SectionHeading
        eyebrow="GET IN TOUCH"
        title="We're Here for You"
        text="Reach out to us using any of the methods below."
      />

      <div class="contact-grid">

        <div class="contact-card">

          <h3>Email</h3>

          <p>info@christianwomencommunity.org</p>

        </div>

        <div class="contact-card">

          <h3>Prayer Meetings</h3>

          <p>Every Thursday • 9:00 PM (UK)</p>

        </div>

        <div class="contact-card">

          <h3>Bible Study</h3>

          <p>Every Tuesday • 7:00 PM (UK)</p>

        </div>

        <div class="contact-card">

          <h3>Follow Us</h3>

          <p>

            Facebook<br>

            Instagram<br>

            YouTube

          </p>

        </div>

      </div>

    </div>

  </section>

  <BecomeVirtuosa />

  <GrowInTheWord />

</Layout>