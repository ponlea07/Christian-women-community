---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BecomeVirtuosa from "../components/BecomeVirtuosa.astro";
import GrowInTheWord from "../components/GrowInTheWord.astro";
import { resources } from "../content/resources";

import {
  BookOpen,
  BookMarked,
  Users,
  BriefcaseBusiness
} from "@lucide/astro";
---

<Layout title="Resources | Christian Women Community">

  <section class="page-hero">

    <div class="container">

      <span class="page-eyebrow">
        RESOURCES
      </span>

      <h1>
        Grow Every Day
      </h1>

      <p>
        Christ-centred resources to strengthen your faith,
        leadership and everyday walk with God.
      </p>

    </div>

  </section>

  <section class="resources-page resources-page-tight">

    <div class="container">

      <SectionHeading
        eyebrow="GROW IN CHRIST"
        title="Resources for Every Season"
        text="From Bible study and devotionals to leadership and kingdom business, discover resources carefully curated to help every Virtuosa grow in faith, wisdom and purpose."
      />

      <div class="featured-resource">

  <div class="featured-resource-content">

    <!-- Left -->

    <div class="featured-resource-text">

      <span class="featured-tag">
        📖 NEW
      </span>

      <h3>
        Read, Search & Study the Bible
      </h3>

      <p>
        Read, search and study God's Word with confidence. Whether you're
        following a Bible reading plan, preparing for Bible study or
        exploring Scripture during prayer, Bible Hub brings everything
        together in one beautiful experience.
      </p>

      <ul class="featured-list">
        <li>Read every book and chapter</li>
        <li>Search Scripture instantly</li>
        <li>Navigate books with ease</li>
        <li>Clean distraction-free reading</li>
      </ul>

      <a href="/bible" class="btn-primary">
        Explore Bible Hub
      </a>

    </div>

    <!-- Right -->

    <div class="featured-resource-image">

      <div class="resource-preview-title">

  <h3>Bible Hub</h3>

  <p class="preview-meta">
    Read • Search • Study
  </p>

</div>
      <img
        src="/images/bible-hub-preview.webp"
        alt="Bible Hub preview"
        loading="lazy"
        decoding="async"
      />

    </div>

  </div>

</div>

      <div class="resources-grid">

        {resources.map((resource) => (

          <article class="resource-card">

            <div class="resource-content">

              <div class="resource-icon">

                {resource.title === "Bible Studies" && (
                  <BookOpen size={48} stroke-width={1.8} />
                )}

                {resource.title === "Devotionals" && (
                  <BookMarked size={48} stroke-width={1.8} />
                )}

                {resource.title === "Leadership" && (
                  <Users size={48} stroke-width={1.8} />
                )}

                {resource.title === "Business" && (
                  <BriefcaseBusiness size={48} stroke-width={1.8} />
                )}

              </div>

              <h3>{resource.title}</h3>

              <p>{resource.description}</p>

            </div>

            {resource.title === "Bible Studies" && (
              <a href="/join" class="btn-primary">
                Join to Access
              </a>
            )}

            {resource.title === "Business" && (
              <a href="/join" class="btn-primary">
                Join to Access
              </a>
            )}

            {resource.title === "Devotionals" && (
              <a href="/bible/devotionals" class="btn-primary">
                Explore
              </a>
            )}

            {resource.title === "Leadership" && (
              <button class="btn-primary btn-disabled" disabled>
                Coming Soon
              </button>
            )}

          </article>

        ))}

      </div>

    </div>

  </section>

  <BecomeVirtuosa />

  <GrowInTheWord />

</Layout>
