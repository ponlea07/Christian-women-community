---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BecomeVirtuosa from "../components/BecomeVirtuosa.astro";
import GrowInTheWord from "../components/GrowInTheWord.astro";
import { resources } from "../content/resources";

import {
  BookOpen,
  BookMarked,
  Users,
  BriefcaseBusiness
} from "@lucide/astro";
---

<Layout title="Resources | Christian Women Community">

  <section class="page-hero">

    <div class="container">

      <span class="page-eyebrow">
        RESOURCES
      </span>

      <h1>
        Grow Every Day
      </h1>

      <p>

        Christ-centred resources to strengthen your faith,
        leadership and everyday walk with God.

      </p>

    </div>

  </section>

  <section class="resources-page">

    <div class="container">

      <SectionHeading
        eyebrow="GROW IN CHRIST"
        title="Resources for Every Season"
        text="Whether you're beginning your faith journey or leading others, these resources are here to encourage and equip you."
      />

      <div class="resources-grid">

        {resources.map((resource) => (

  <article class="resource-card">

    <div class="resource-content">

      <div class="resource-icon">

        {resource.title === "Bible Studies" && (
          <BookOpen size={48} stroke-width={1.8} />
        )}

        {resource.title === "Devotionals" && (
          <BookMarked size={48} stroke-width={1.8} />
        )}

        {resource.title === "Leadership" && (
          <Users size={48} stroke-width={1.8} />
        )}

        {resource.title === "Business" && (
          <BriefcaseBusiness size={48} stroke-width={1.8} />
        )}

      </div>

      <h3>{resource.title}</h3>

      <p>{resource.description}</p>

    </div>

    {resource.title === "Bible Studies" && (
      <a href="/join" class="btn-primary">
        Join to Access
      </a>
    )}

    {resource.title === "Business" && (
      <a href="/join" class="btn-primary">
        Join to Access
      </a>
    )}

    {resource.title === "Devotionals" && (
      <a href="/devotionals" class="btn-primary">
        Explore
      </a>
    )}

    {resource.title === "Leadership" && (
      <button class="btn-primary btn-disabled" disabled>
        Coming Soon
      </button>
    )}

  </article>

))}
        ))

      </div>

    </div>

  </section>

  <BecomeVirtuosa />

  <GrowInTheWord />

</Layout>