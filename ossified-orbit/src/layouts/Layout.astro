---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import SanctuaryFooter from "../components/SanctuaryFooter.astro";

interface Props {
  title?: string;
}

const {
  title = "Christian Women Community | Donna Virtuosa"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <script is:inline>
  (() => {
    const savedTheme = localStorage.getItem("theme");

    if (
      savedTheme === "dark" ||
      (!savedTheme &&
        window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.dataset.theme = "dark";
    }
  })();
</script>
  <title>{title}</title>
  <link rel="manifest" href="/manifest.webmanifest" />

  <meta
    name="description"
    content="Christian Women Community is a Christ-centred global community helping women grow in faith, purpose, leadership and Kingdom impact through biblical teaching, prayer, mentorship and authentic sisterhood."
  />

  <meta
    name="keywords"
    content="Christian Women, Women's Ministry, Bible Study, Prayer, Christian Community, Mentorship, Donna Virtuosa"
  />

  <meta name="author" content="Christian Women Community" />
  <meta
  name="theme-color"
  content="#0F6B73"
  id="theme-color"
/>
  <!-- Canonical -->
  <link
    rel="canonical"
    href="https://christian-women-community.vercel.app/"
  />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta
    property="og:title"
    content="Christian Women Community | Growing Women. Building Legacy."
  />
  <meta
    property="og:description"
    content="A Christ-centred global community helping women grow in faith, discover purpose and advance God's Kingdom."
  />
  <meta
    property="og:image"
    content="https://christian-women-community.vercel.app/images/cwc-official-logo.png"
  />
  <meta
    property="og:url"
    content="https://christian-women-community.vercel.app"
  />
  <meta property="og:site_name" content="Christian Women Community" />

  <!-- X / Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta
    name="twitter:title"
    content="Christian Women Community"
  />
  <meta
    name="twitter:description"
    content="Growing Women. Building Legacy. Advancing God's Kingdom."
  />
  <meta
    name="twitter:image"
    content="https://christian-women-community.vercel.app/images/cwc-official-logo.png"
  />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>

<body>

  <Navbar />

  <main>
    <slot />
  </main>

  <SanctuaryFooter />

  <script is:inline>
  if ("serviceWorker" in navigator) {
    const isLocalhost =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1";

    if (isLocalhost) {
      navigator.serviceWorker
        .getRegistrations()
        .then((registrations) => {
          registrations.forEach((registration) => {
            registration.unregister();
          });
        })
        .catch((error) => {
          console.error(
            "Service worker cleanup failed:",
            error
          );
        });
    } else {
      window.addEventListener("load", () => {
        navigator.serviceWorker
          .register("/sw.js")
          .catch((error) => {
            console.error(
              "Service worker registration failed:",
              error
            );
          });
      });
    }
  }
</script>
</body>
</html>
