---
---

<section class="contact-form-section">

  <div class="container">

    <div class="contact-form-wrapper">

      <span class="form-tag">
        CONTACT & PRAYER
      </span>

      <h2>
        Send Us a Message
      </h2>

      <p class="form-intro">
        Whether you'd like us to stand with you in prayer, have a question,
        would like to partner with us, or simply want to say hello,
        we'd love to hear from you.
      </p>

      <form
  action="https://formspree.io/f/xvkpzowb"
  method="POST"
  class="contact-form"
>

  <input
    type="hidden"
    name="_subject"
    value="New Contact & Prayer Message"
  />

  <!-- Name & Email -->
  <div class="form-grid">

    <div class="form-group">

      <label for="name">
        Full Name
      </label>

      <input
        id="name"
        name="name"
        type="text"
        placeholder="Your full name"
        required
      />

    </div>

    <div class="form-group">

      <label for="email">
        Email Address
      </label>

      <input
        id="email"
        name="email"
        type="email"
        placeholder="you@example.com"
        required
      />

    </div>

  </div>

  <!-- Phone -->
  <div class="form-group">

    <label for="phone">
      Phone Number (Optional)
    </label>

    <input
      id="phone"
      name="phone"
      type="tel"
      placeholder="+44 7123 456789"
    />

  </div>

  <!-- Subject -->
  <div class="form-group">

    <label for="subject">
      How can we help?
    </label>

    <select
      id="subject"
      name="subject"
      required
    >

      <option value="">
        Please choose...
      </option>

      <option value="Prayer Request">
        🙏 Prayer Request
      </option>

      <option value="General Enquiry">
        💬 General Enquiry
      </option>

      <option value="Partnership">
        🤝 Partnership
      </option>

      <option value="Testimony">
        ✨ Testimony
      </option>

      <option value="Feedback">
        💙 Feedback
      </option>

    </select>

  </div>

  <!-- Message -->
  <div class="form-group">

    <label for="message">
      Message
    </label>

    <textarea
  id="message"
  name="message"
  rows="7"
  placeholder="Tell us how we can help..."
  required
></textarea>

  </div>

  <!-- Submit Button -->
  <button
    type="submit"
    class="btn-primary"
  >
    Send Your Message
  </button>

</form>
       
      </div>

    </div>


</section>

<style>

.contact-form-section{
    padding:6rem 0;
    background:var(--color-surface);
}

.contact-form-wrapper{
    max-width:760px;
    margin:0 auto;
    text-align:center;
}

.form-tag{
    display:inline-block;
    padding:.45rem 1rem;
    background:var(--color-accent);
    color:var(--color-button-text);
    border-radius:999px;
    font-size:.8rem;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:1rem;
}

.contact-form-wrapper h2{
    font-family:"Cormorant Garamond",serif;
    font-size:3rem;
    color:var(--color-surface-text);
    margin-bottom:1rem;
}

.form-intro{
    color:var(--color-surface-text-muted);
    line-height:1.9;
    max-width:620px;
    margin:0 auto 3rem;
}

.contact-form{
    display:flex;
    flex-direction:column;
    gap:1.5rem;
    text-align:left;

    background:var(--color-surface);
    padding:3rem;
    border-radius:24px;
    box-shadow:0 20px 60px rgba(0,0,0,.08);
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:1.5rem;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.form-group label{
    font-weight:600;
    color:var(--color-surface-text);
    margin-bottom:.6rem;
}

.form-group input,
.form-group select,
.form-group textarea{
    padding:1rem;
    border:1px solid color-mix(in srgb, var(--color-surface-text) 20%, transparent);
    border-radius:14px;
    background:var(--color-surface);
    color:var(--color-surface-text);
    font:inherit;
    transition:border-color .25s ease,
               box-shadow .25s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
    outline:none;
    border-color:var(--color-accent);
    box-shadow:0 0 0 4px rgba(212,175,55,.18);
}
.form-group input:hover,
.form-group select:hover,
.form-group textarea:hover{
    border-color:var(--color-accent);
}
.form-group input::placeholder,
.form-group textarea::placeholder{
    color:var(--color-surface-text-muted);
}

.contact-form .btn-primary{
    align-self:center;
    margin-top:1rem;
    min-width:220px;
}

.form-group textarea{
    resize:vertical;
    min-height:180px;
}
@media(max-width:768px){

    .contact-form-wrapper h2{
        font-size:2.3rem;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .contact-form{
        padding:2rem;
    }

}



</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const subject = document.getElementById("subject") as HTMLSelectElement | null;
  const message = document.getElementById("message") as HTMLTextAreaElement | null;

  if (!subject || !message) return;

  const placeholders: Record<string, string> = {

    "Prayer Request":
      "What would you like us to join our faith with yours on? Share as much or as little as you're comfortable with.",

    "General Enquiry":
      "How can we help you today?",

    "Partnership":
      "Tell us how you'd like to partner with the Christian Women Community.",

    "Testimony":
      "Share how God has been working in your life. We'd love to rejoice with you.",

    "Feedback":
      "We'd love to hear your thoughts or suggestions."

  };

  subject.addEventListener("change", () => {

    message.placeholder =
      placeholders[subject.value] ??
      "Tell us how we can help...";

  });

});
</script>
