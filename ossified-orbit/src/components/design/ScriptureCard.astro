---
interface Props {
  reference: string;
  text: string;
  action?: string;
  href?: string;
}

const {
  reference,
  text,
  action,
  href
} = Astro.props;
---

<article class="scripture-card">

  <p class="scripture-text">
    “{text}”
  </p>

  <p class="scripture-reference">
    {reference}
  </p>

  {
    action && href ? (
      <a href={href} class="scripture-action">
        {action}
      </a>
    ) : null
  }

</article>

<style>
.scripture-card {
  max-width: 760px;
  margin: 0 auto;
  padding: 2.5rem 2rem;
  text-align: center;

  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(212, 175, 55, 0.22);
  border-radius: 24px;

  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06);
}

.scripture-text {
  margin: 0 0 1.5rem;

  color: #ffffff;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.5rem, 3vw, 2rem);
  line-height: 1.6;
}

.scripture-reference {
  margin: 0 0 1.5rem;

  color: #d4af37;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.scripture-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0.8rem 1.5rem;

  border-radius: 999px;

  background: #d4af37;
  color: #0f6b73;

  text-decoration: none;
  font-weight: 700;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.scripture-action:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(212, 175, 55, 0.35);
}
</style>