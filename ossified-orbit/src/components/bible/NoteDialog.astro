---
---

<dialog
  id="note-dialog"
  class="note-dialog"
  aria-labelledby="note-dialog-title"
>
  <form method="dialog" class="note-dialog__content">
    <header class="note-dialog__header">
      <h2 id="note-dialog-title">
  Add Note
</h2>
    </header>

    <p id="note-reference" class="note-dialog__reference"></p>

    <label for="note-text" class="sr-only">
  Note
</label>
    <textarea
      id="note-text"
      class="note-dialog__textarea"
      placeholder="Write your thoughts about this verse..."
      rows="8"
    ></textarea>

    <footer class="note-dialog__footer">
      <button
        type="button"
        id="cancel-note"
        class="note-button note-button--secondary"
      >
        Cancel
      </button>

      <button
        type="button"
        id="save-note"
        class="note-button note-button--primary"
      >
        Save Note
      </button>
    </footer>
  </form>
</dialog>

<style>
.note-dialog {
  width: min(90vw, 600px);
  border: none;
  border-radius: 1rem;
  padding: 0;
  background: #103d43;
  color: white;
}

.note-dialog::backdrop {
  background: rgba(0, 0, 0, 0.6);
}

.note-dialog__content {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem;
}

.note-dialog__header h2 {
  margin: 0;
}

.note-dialog__reference {
  color: #d4af37;
  font-weight: 600;
}

.note-dialog__textarea {
  width: 100%;
  min-height: 180px;
  padding: 0.75rem;

  border: 1px solid rgba(255,255,255,.2);
  border-radius: .75rem;

  background: rgba(255,255,255,.05);
  color: inherit;

  resize: vertical;
}

.note-dialog__footer {
  display: flex;
  justify-content: flex-end;
  gap: .75rem;
}

.note-button {
  padding: .6rem 1rem;
  border-radius: .6rem;
  cursor: pointer;
}

.note-button--secondary {
  background: transparent;
  color: white;
  border: 1px solid rgba(255,255,255,.2);
}

.note-button--primary {
  background: #D4AF37;
  color: #103d43;
  border: none;
  font-weight: 600;
}
.sr-only {
  position: absolute;

  width: 1px;
  height: 1px;

  padding: 0;
  margin: -1px;

  overflow: hidden;

  clip: rect(0, 0, 0, 0);
  white-space: nowrap;

  border: 0;
}
</style>