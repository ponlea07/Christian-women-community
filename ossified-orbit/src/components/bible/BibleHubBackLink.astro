---
---

<div class="back-to-bible-hub">
  <div class="back-to-bible-hub__content">
    <span class="back-to-bible-hub__icon" aria-hidden="true">📖</span>

    <div>
      <h3>Continue Exploring Bible Hub</h3>

      <p>
        Read Scripture, discover devotionals, follow reading plans and more.
      </p>
    </div>
  </div>

  <a
    href="/bible"
    class="back-to-bible-hub__button"
  >
    Back to Bible Hub
  </a>
</div>

<style>
  .back-to-bible-hub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;

    margin-top: 4rem;
    padding: 1.5rem 2rem;

    border: 1px solid rgba(212, 175, 55, 0.35);
    border-left: 4px solid var(--color-accent);
    border-radius: 1rem;

    background: var(--color-surface-soft);
  }

  .back-to-bible-hub__content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .back-to-bible-hub__icon {
    flex-shrink: 0;
    font-size: 1.5rem;
  }

  .back-to-bible-hub__content h3 {
    margin: 0 0 0.35rem;
    color: var(--color-surface-text);
    font-family: "Cormorant Garamond", serif;
    font-size: 1.4rem;
  }

  .back-to-bible-hub__content p {
    margin: 0;
    color: var(--color-surface-text-muted);
    line-height: 1.5;
  }

  .back-to-bible-hub__button {
    flex-shrink: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0.75rem 1.25rem;

    border: 1px solid var(--color-accent);
    border-radius: 0.6rem;

    background: var(--color-accent);
    color: var(--color-button-text);

    text-decoration: none;
    font-weight: 700;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .back-to-bible-hub__button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  @media (max-width: 700px) {
    .back-to-bible-hub {
      flex-direction: column;
      align-items: flex-start;
    }

    .back-to-bible-hub__button {
      width: 100%;
      text-align: center;
    }
  }
</style>