---
import type { BibleChapter } from "../../content/bible/types";
import Verse from "./Verse.astro";

interface Props {
  verses: BibleChapter;
  book: string;
  bookName: string;
  chapter: number;
}

const {
  verses,
  book,
  bookName,
  chapter,
} = Astro.props;
---

<div class="bible-reader">
  {
    verses.map((verse) => (
      <Verse
        verse={verse}
        book={book}
        bookName={bookName}
        chapter={chapter}
      />
    ))
  }
</div>

<style>
.bible-reader {
  max-width: 760px;
  margin: 0 auto;
  font-size: 1.15rem;
  line-height: 2;
}
</style>