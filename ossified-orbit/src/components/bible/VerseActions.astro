---
import {
  Copy,
  NotebookPen,
  Share2,
  Highlighter,
} from "@lucide/astro";

import type { BibleVerse } from "../../content/bible/types";

interface Props {
  verse: BibleVerse;
  book: string;
  bookName: string;
  chapter: number;
}

const {
  verse,
  book,
  bookName,
  chapter,
} = Astro.props;
---

<div class="verse-actions">

  <!-- Copy -->
  <button
    type="button"
    class="verse-action"
    data-action="copy"
    data-book={book}
    data-book-name={bookName}
    data-chapter={chapter}
    data-verse={verse.verse}
    data-text={verse.text}
    aria-label={`Copy verse ${verse.verse}`}
    title="Copy verse"
  >
    <Copy size={18} />
  </button>

  <!-- Share -->
  <button
    type="button"
    class="verse-action"
    data-action="share"
    data-book={book}
    data-book-name={bookName}
    data-chapter={chapter}
    data-verse={verse.verse}
    data-text={verse.text}
    aria-label={`Share verse ${verse.verse}`}
    title="Share verse"
  >
    <Share2 size={18} />
  </button>

  <!-- Note -->
  <button
    type="button"
    class="verse-action"
    data-action="note"
    data-book={book}
    data-book-name={bookName}
    data-chapter={chapter}
    data-verse={verse.verse}
    aria-label={`Add a note to verse ${verse.verse}`}
    title="Add note"
  >
    <NotebookPen size={18} />
  </button>

  <!-- Highlight -->
  <button
    type="button"
    class="verse-action"
    data-action="highlight"
    data-book={book}
    data-book-name={bookName}
    data-chapter={chapter}
    data-verse={verse.verse}
    data-text={verse.text}
    aria-label={`Highlight verse ${verse.verse}`}
    title="Highlight verse"
  >
    <Highlighter size={18} />
  </button>

</div>
