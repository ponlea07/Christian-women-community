---
import type { BibleVerse } from "../../content/bible/types";
import VerseActions from "./VerseActions.astro";

interface Props {
  verse: BibleVerse;
  book: string;
  bookName: string;
  chapter: number;
}

const {
  verse,
  book,
  bookName,
  chapter,
} = Astro.props;
---

<article
  id={`verse-${verse.verse}`}
  class="verse"
  tabindex="0"
  data-book={book}
  data-chapter={chapter}
  data-verse={verse.verse}
>
  <p class="verse-text">
    <sup>{verse.verse}</sup>
    <span>{verse.text}</span>
  </p>

  <VerseActions
    verse={verse}
    book={book}
    bookName={bookName}
    chapter={chapter}
  />
</article>

<style>
.verse {
  margin-bottom: 1rem;
  scroll-margin-top: 6rem;
}

.verse-content {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1rem;
  align-items: start;
}

.verse-text {
  margin: 0;
}

.verse-text sup {
  margin-right: .45rem;
  color: var(--color-accent);
  font-size: .8rem;
  font-weight: 700;
}

.verse-text span {
  color: var(--color-text);
}

.verse:target {
  background: rgba(212, 175, 55, 0.12);
  border-radius: .5rem;
}

.verse-highlighted {
  background: rgba(212, 175, 55, 0.12);
  border-left: 4px solid var(--color-accent);
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  transition: background 0.2s ease;
}

</style>
