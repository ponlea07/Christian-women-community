---
interface Props {
  bookSlug: string;
  chapterCount: number;
  currentChapter: number;
}

const {
  bookSlug,
  chapterCount,
  currentChapter,
} = Astro.props;
---

<div class="chapter-picker">

  <label for="chapter-select">Chapter</label>

  <select
  id="chapter-select"
  data-book={bookSlug}
>
  {
    Array.from({ length: chapterCount }, (_, i) => i + 1).map((chapter) => (
      <option
        value={chapter}
        selected={chapter === currentChapter}
      >
        Chapter {chapter}
      </option>
    ))
  }
</select>
</div>

<style>
.chapter-picker{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:.75rem;
  margin:2rem 0;
}

.chapter-picker label{
  color:var(--color-accent);
  font-weight:600;
}

.chapter-picker select{
  background:var(--color-surface);
  color:var(--color-surface-text);
  border:none;
  border-radius:8px;
  padding:.65rem 1rem;
  font-size:1rem;
  cursor:pointer;
}
</style>
