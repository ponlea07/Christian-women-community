---
import SectionHeading from "./SectionHeading.astro";
---

<section class="resources">

  <div class="container">

    <SectionHeading
      eyebrow="VIRTUOSA RESOURCES"
      title="Grow Every Day"
      text="Practical, Christ-centred resources designed to strengthen your faith, leadership and everyday life."
    />

    <div class="resources-grid">

      <article class="resource-card">

        <div class="resource-icon">📖</div>

        <h3>Bible Studies</h3>

        <p>
          Dive deeper into God's Word through guided studies for every stage of your faith journey.
        </p>

      </article>

      <article class="resource-card featured">

        <div class="resource-icon">🎙️</div>

        <h3>Podcasts</h3>

        <p>
          Listen to inspiring conversations on faith, purpose, relationships and leadership.
        </p>

      </article>

      <article class="resource-card">

        <div class="resource-icon">💼</div>

        <h3>Business Resources</h3>

        <p>
          Practical tools and Kingdom principles to help Christian women thrive in business.
        </p>

      </article>

      <a href="/bible/devotionals" class="resource-card" aria-label="Explore devotionals">

        <div class="resource-icon">❤️</div>

        <h3>Devotionals</h3>

        <p>
          Daily encouragement to strengthen your walk with Christ and keep your heart focused on Him.
        </p>

      </a>

    </div>

    <div class="resource-button">

      <a href="/resources" class="btn-primary">

        Explore All Resources →

      </a>

    </div>

  </div>

</section>
