---
interface Business {
  initials: string;
  category: string;
  name: string;
  description: string;
  link: string;
}

interface Props {
  business: Business;
  ctaLabel?: string;
  ctaVariant?: "text" | "button";
}

const {
  business,
  ctaLabel = "View Profile →",
  ctaVariant = "text"
} = Astro.props;
---

<article class="business-card">

  <div class="business-logo">
    {business.initials}
  </div>

  <span class="category">
    {business.category}
  </span>

  <h3>{business.name}</h3>

  <p>{business.description}</p>

  <a
    href={business.link}
    class:list={[
      "business-card__cta",
      `business-card__cta--${ctaVariant}`
    ]}
  >
    {ctaLabel}
  </a>

</article>
