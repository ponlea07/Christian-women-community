---
import monthlyVerse from "../content/featured/monthly-verse";
---

<section class="grow-word">

  <div class="container">

    <div class="word-grid">

      <!-- Verse of the Month -->

      <div class="verse-card">

        <span class="eyebrow">
          VERSE OF THE MONTH
        </span>

        <h2>
          "{monthlyVerse.text}"
        </h2>

        <p class="reference">
          {monthlyVerse.reference}
        </p>

        <p>
          {monthlyVerse.meditation}
        </p>

        <a
          href={`/bible/${monthlyVerse.book}/${monthlyVerse.chapter}`}
          class="btn-primary"
        >
          Read Full Chapter →
        </a>

      </div>

      <!-- Bible Hub -->

      <div class="bible-hub-card">

        <h3>
  Take Bible Hub With You
</h3>

<p class="bible-hub-card-text">
  Scan to continue reading, searching and studying God's Word wherever you are.
</p>

<img
  src="/images/bible-hub-qr.png"
  alt="Scan to open Bible Hub"
  class="bible-qr"
  loading="lazy"
  decoding="async"
/>

<a href="/bible" class="btn-primary">
  Open Bible Hub →
</a>

      </div>

    </div>

    <div class="scripture-ribbon">

      <div class="scripture-track">

        Isaiah 41:10 ✦ Psalm 46:5 ✦ Proverbs 31:25 ✦ Romans 8:28 ✦ Hebrews 11:1 ✦ Matthew 6:33 ✦ Philippians 4:13 ✦ Isaiah 40:31 ✦ Psalm 23 ✦ Lamentations 3:22–23 ✦

      </div>

    </div>

  </div>

</section>