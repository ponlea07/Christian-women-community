---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  theme?: "light" | "dark";
}

const {
  eyebrow,
  title,
  text,
  theme = "dark"
} = Astro.props;
---

<div class={`section-heading ${theme}`}>

  <span class="eyebrow">
    {eyebrow}
  </span>

  <div class="gold-flourish">

    <span></span>

    <div class="section-icon">
      ✦
    </div>

    <span></span>

  </div>

  <h2>
    {title}
  </h2>

  {text && (
    <p class="section-heading-text">
      {text}
    </p>
  )}

</div>

<style>
.section-heading-text{
  color: #ffffff;
}
</style>