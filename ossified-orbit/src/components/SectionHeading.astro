---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  theme?: "light" | "dark";
}

const {
  eyebrow,
  title,
  text,
  theme = "dark"
} = Astro.props;
---

<div class={`section-heading ${theme}`}>

  <span class="eyebrow">
    {eyebrow}
  </span>

  <div class="gold-flourish">

    <span class="line"></span>

    <div class="crown">
      ✦
    </div>

    <span class="line"></span>

  </div>

  <h2>
    {title}
  </h2>

  {text && (
    <p>
      {text}
    </p>
  )}

</div>